# H.I.R.E. — Backend Environment Configuration Example
# Copy this file to .env and fill in your values.
# Never commit the real .env file to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=H.I.R.E.
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# ── Security ──────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate a strong key:
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_THIS_WITH_A_REAL_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Vite dev server.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ── Database (optional — not required for hackathon demo) ─────────────────────
# DATABASE_URL=postgresql://username:password@localhost:5432/hire_db

# ── AI Providers (optional — not required for rule-based analysis) ────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=